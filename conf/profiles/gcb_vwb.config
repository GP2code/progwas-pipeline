/*
 * GCB_VEB profile - used for Google Cloud Batch execution on Verily Workbench
 * Allows sclaing of SSD/CPU resources using params.gcb_ssd_quota_gb / params.gcb_cpu_quota
 */

workDir = "${params.project_dir}/work"
cleanup = false

def gcbScale = Math.min(params.gcb_ssd_quota_gb / 500.0, params.gcb_cpu_quota / 200.0)

process {
    executor = 'google-batch'
    container = params.gcb_container
    errorStrategy = { task.exitStatus in [14, 143, 104] || task.exitStatus == null ? 'retry' : 'terminate' }
    maxRetries = 5

    beforeScript = '''
        echo "=== Task Environment ===" >&2
        echo "Task started: $(date)" >&2
        echo "Hostname: $(hostname)" >&2
        echo "CPUs: $(nproc)" >&2
        echo "Memory: $(free -h | awk '/^Mem:/ {print $7 " available of " $2}')" >&2
        echo "Disk: $(df -h . | tail -1 | awk '{print $4 " available of " $2}')" >&2
        echo "======================" >&2
    '''.stripIndent()

    afterScript = '''
        EXIT_CODE=$?
        echo "=== Task Completion ===" >&2
        echo "Task finished: $(date)" >&2
        echo "Exit code: $EXIT_CODE" >&2
        echo "Memory used: $(free -h | awk '/^Mem:/ {print $3}')" >&2
        echo "======================" >&2
        exit $EXIT_CODE
    '''.stripIndent()

    withLabel: small {
        cpus = 2
        memory = '4 GB'
        time = '2h'
        disk = '20 GB'
    }

    withLabel: medium {
        cpus = 4
        memory = '8 GB'
        time = '4h'
        disk = '30 GB'
    }

    withLabel: large {
        cpus = 8
        memory = '16 GB'
        time = '8h'
        disk = '200 GB'
    }

    withName: 'COMPUTE_PCA' {
        cpus = 8
        memory = '16 GB'
        time = '8h'
        disk = '100 GB'
    }

    withLabel: very_large {
        cpus = 16
        memory = '256 GB'
        time = '12h'
        disk = '200 GB'
    }

    withLabel: two_cpu_large_mem {
        cpus = 2
        memory = '128 GB'
        time = '2h'
        disk = '200 GB'
    }

    withName: 'RAWFILE_EXPORT' {
        cpus = 2
        memory = '4 GB'
        time = '2h'
        disk = '100 GB'
        maxForks = Math.max(1, Math.floor(2 * gcbScale) as int)
    }
    withName: 'SPLIT_VCF' {
        cpus = 2
        memory = '4 GB'
        time = '2h'
        disk = '70 GB'
        maxForks = Math.max(1, Math.floor(4 * gcbScale) as int)
    }
    withName: 'LD_PRUNE_CHR' {
        cpus = 2
        memory = '4 GB'
        time = '2h'
        disk = '50 GB'
        maxForks = Math.max(1, Math.floor(4 * gcbScale) as int)
    }
    withName: 'GWASCPH' {
        cpus = 2
        memory = '4 GB'
        time = '2h'
        disk = '20 GB'
        maxForks = Math.max(1, Math.floor(8 * gcbScale) as int)
    }

    withName: 'GENETICQC' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
        disk = '60 GB'
        maxForks = Math.max(1, Math.floor(5 * gcbScale) as int)
    }
    withName: 'GWASGALLOP' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
        disk = '30 GB'
        maxForks = Math.max(1, Math.floor(6 * gcbScale) as int)
    }
    withName: 'GWASGLM' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
        disk = '45 GB'
        maxForks = Math.max(1, Math.floor(4 * gcbScale) as int)
    }

    withName: 'SIMPLE_QC' {
        cpus = 4
        memory = '8 GB'
        time = '4h'
        disk = '150 GB'
    }

    withName: 'GENETICQCPLINK' {
        cpus = 8
        memory = '32 GB'
        time = '2h'
        disk = '100 GB'
        maxForks = Math.max(1, Math.floor(4 * gcbScale) as int)
    }
}

executor {
    queueSize = 200
    submitRateLimit = '10 sec'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/work/users/$USER/singularity_cache'
}

google {
    region = 'europe-west4'
    location = 'europe-west4'
    project = "${GOOGLE_CLOUD_PROJECT}"
    batch.serviceAccountEmail = "${GOOGLE_SERVICE_ACCOUNT_EMAIL}"
    batch.usePrivateAddress = params.gcb_use_private_address
    batch.network = 'global/networks/network'
    batch.subnetwork = "regions/europe-west4/subnetworks/subnetwork"
    batch.bootDiskSize = '100 GB'
    batch.allowedLocations = ['zones/europe-west4-a', 'zones/europe-west4-b']
}
