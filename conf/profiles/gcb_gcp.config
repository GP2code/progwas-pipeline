/*
 * GCB_GCP profile - Google Cloud Batch on a plain (non-VWB) GCP project.
 *
 * Thin modification of gcb_vwb.config: it inherits the entire process{} resource table
 * and only replaces environment-specific settings. Resource, disk and maxForks-baseline
 * changes belong in gcb_vwb.config so both profiles stay in sync -- the old gcb2.config
 * drifted precisely because it was a standalone copy.
 *
 * What differs from VWB:
 *   - no external-IP org policy, so usePrivateAddress = false
 *   - no VWB named network/subnetwork; Batch uses the project default network
 *   - different regional quota, so the maxForks baseline scales up
 */

// ==============================================================================
// MUST come before includeConfig -- do not move this block below it.
// gcb_vwb.config derives its maxForks from these params via a `def gcbScale = ...` that
// Groovy evaluates once, while that file is being parsed, i.e. at the includeConfig line
// below. Params declared after it are set too late: gcbScale will already have been
// computed from the conf/params.config defaults and the values here silently ignored.
//
// TODO: replace with this project's actual regional quota:
//   gcloud compute regions describe <region> --project <project> \
//     --format="table(quotas.metric,quotas.limit)" | grep -E "SSD_TOTAL_GB|^CPUS"
// Leaving the VWB values here is safe but throttles the run unnecessarily.
// ==============================================================================
params {
    gcb_use_private_address = false
    gcb_ssd_quota_gb        = 500   // TODO: actual SSD_TOTAL_GB for this region
    gcb_cpu_quota           = 200   // TODO: actual CPUS for this region
}

includeConfig 'gcb_vwb.config'

google {
    // TODO: set to the region holding the input data; must match the quota above.
    region = 'europe-west4'
    location = 'europe-west4'
    project = "${GOOGLE_CLOUD_PROJECT}"
    batch.serviceAccountEmail = "${GOOGLE_SERVICE_ACCOUNT_EMAIL}"
    batch.usePrivateAddress = params.gcb_use_private_address
    // Clear the VWB named network/subnetwork so Batch falls back to the project default.
    // VERIFY ON FIRST RUN: Nextflow should treat an explicit null the same as unset, but
    // if Batch rejects the request with an invalid-network error, drop the includeConfig
    // and give this profile its own standalone google{} block instead.
    batch.network = null
    batch.subnetwork = null
    batch.bootDiskSize = '100 GB'
    // Unpinned: let Batch pick any zone in the region. Narrow this if the input bucket
    // is zonal or quota is concentrated in specific zones.
    batch.allowedLocations = null
}
